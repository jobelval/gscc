# Copiez ce fichier en .env et remplissez vos valeurs réelles.
# NE JAMAIS mettre .env dans git.

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://votredomaine.com/gscc/auth/google-callback.php

# Base de données
DB_HOST=localhost
DB_NAME=gscc
DB_USER=your_db_user
DB_PASS=your_db_password

# Site
SITE_URL=https://votredomaine.com/gscc
