# Secrets — ne jamais committer
.env

# Uploads — jamais suivis par git : ces fichiers sont ajoutés depuis le CMS
# (en local ou en direct sur le site en ligne) et ne doivent JAMAIS pouvoir
# etre supprimes par un commit/push ou un deploiement cPanel.
uploads/*/*
!uploads/*/.gitkeep

# Logs
*.log
logs/

# Cache
cache/
*.cache

# Éditeurs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
