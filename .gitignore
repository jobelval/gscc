# Secrets — ne jamais committer
.env

# Uploads — les photos sont ajoutees depuis le CMS (en local ou en direct sur
# le site en ligne). Les NOUVEAUX fichiers ne sont jamais suivis par git afin
# qu'un commit/push ou un deploiement cPanel ne puisse plus jamais les supprimer.
# Les images deja suivies avant cette regle restent trackees normalement.
uploads/*/*
!uploads/*/.gitkeep

# Logs
*.log
logs/

# Cache
cache/
*.cache

# Éditeurs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
